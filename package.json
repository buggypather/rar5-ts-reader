{
  "name": "rar5-ts-reader",
  "version": "0.1.0",
  "description": "List what's inside a RAR 5 archive by reading only its headers. TypeScript, no dependencies, works in browsers and Node.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": ["rar", "rar5", "archive", "list", "unrar"],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
